#--------------------------------------------------------------------
# AICOUNTLY Partner Portal (CodeIgniter 4) — environment template
#
# Copy to .env and fill in real values. NEVER commit a real .env.
# On cPanel this file lives in the document root for partner.aicountly.com
# and is created/maintained directly on the server — deployment never
# overwrites or deletes it.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
# This is the API half of the portal. It is deployed to public_html/api on
# partner.aicountly.com; the built SPA (web/dist) is served from the root.
#--------------------------------------------------------------------

app.baseURL = 'https://partner.aicountly.com/api/'
app.indexPage = ''
app.appTimezone = 'UTC'
# Redirect http:// to https:// (defaults to on when CI_ENVIRONMENT=production).
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE — owned by this portal
#
# This is the single source of truth for partner data: no other service
# stores partner rows. Engage's Add/Edit/Delete/List screens call this
# portal's admin API (see PARTNER_ADMIN_KEY below) rather than writing to a
# database of their own. Use a database dedicated to this portal — do not
# point it at Engage's database. Credentials come only from this file.
#
# The native CodeIgniter names (database.default.hostname, .database,
# .username, .password, .DBDriver, .port) are also honoured; if both are
# present the PARTNER_DB_* values win.
#--------------------------------------------------------------------

PARTNER_DB_HOST = 127.0.0.1
PARTNER_DB_PORT = 5432
PARTNER_DB_NAME = partner_aicountly
PARTNER_DB_USER =
PARTNER_DB_PASSWORD =
PARTNER_DB_DRIVER = Postgre
PARTNER_DB_SCHEMA = public

# Equivalent native CodeIgniter form (use either style, not both):
# database.default.hostname = 127.0.0.1
# database.default.port = 5432
# database.default.database = partner_aicountly
# database.default.username =
# database.default.password =
# database.default.DBDriver = Postgre

#--------------------------------------------------------------------
# ADMIN API — lets Engage's Partner Master screens manage partners here
# without Engage storing any partner data itself.
#
# Generate: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
# Set the SAME value as PARTNER_PORTAL_ADMIN_KEY in Engage's api/.env.
#--------------------------------------------------------------------

PARTNER_ADMIN_KEY =

#--------------------------------------------------------------------
# ENCRYPTION
# Generate with: php spark key:generate
# (or: php -r "echo 'hex2bin:'.bin2hex(random_bytes(32)).PHP_EOL;")
#--------------------------------------------------------------------

encryption.key =

#--------------------------------------------------------------------
# SESSION
# File-based sessions live in writable/session — that directory is preserved
# across deployments so partners are not signed out by a release.
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = 'partner_portal_session'
session.savePath = null
session.expiration = 7200
session.regenerateDestroy = true

#--------------------------------------------------------------------
# COOKIES — must be secure in production (HTTPS only, not readable by JS)
#--------------------------------------------------------------------

cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Strict'

#--------------------------------------------------------------------
# CSRF
#--------------------------------------------------------------------

# The token stays server-side and is published on every response as an
# X-CSRF-TOKEN header, which the SPA echoes back on writes — it is
# deliberately not put in a JS-readable cookie, so the session cookie keeps
# HttpOnly. Do not enable tokenRandomize: the SPA caches one token value and
# a randomised token would invalidate it before it could be reused.
security.csrfProtection = 'session'
security.tokenRandomize = false
security.expires = 7200
security.regenerate = true

#--------------------------------------------------------------------
# CORS — only needed for local development, where Vite runs on :5173.
# In production the SPA and API share an origin, so leave this empty.
#--------------------------------------------------------------------

PARTNER_ALLOWED_ORIGINS =

#--------------------------------------------------------------------
# LOGGING — 4 = info and above. Use 9 only while debugging.
#--------------------------------------------------------------------

logger.threshold = 4

#--------------------------------------------------------------------
# CACHE
#--------------------------------------------------------------------

cache.handler = 'file'
cache.storePath = null

#--------------------------------------------------------------------
# EMAIL (optional — not used by the first release of the portal)
#--------------------------------------------------------------------

# email.fromEmail = 'no-reply@aicountly.com'
# email.fromName = 'AICOUNTLY Partner Portal'
# email.protocol = 'smtp'
# email.SMTPHost =
# email.SMTPUser =
# email.SMTPPass =
# email.SMTPPort = 587
# email.SMTPCrypto = 'tls'

RewriteEngine On
RewriteBase /

# Block direct access to application internals (flat cPanel layout).
RewriteRule ^(app|scripts|tests|vendor|writable)/ - [F,L]
RewriteRule ^(composer\.(json|lock)|spark|check-env\.php|dev-server\.php|REVISION)$ - [F,L]

<FilesMatch "^\.env">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Serve real files/directories directly; everything else goes to CodeIgniter.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

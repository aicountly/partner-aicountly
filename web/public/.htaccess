<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Never let the SPA rewrite swallow API requests (api/ has its own .htaccess).
  RewriteRule ^api(/|$) - [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

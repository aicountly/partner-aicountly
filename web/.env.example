# Partner Portal frontend (Vite)
# Relative path on partner.aicountly.com (recommended): /api
# Or absolute: https://partner.aicountly.com/api  — NOT the domain root alone.
# It must stay same-origin with the SPA so the session cookie is sent.
VITE_API_URL=/api
VITE_APP_NAME=AICOUNTLY Partner Portal

# Never commit real environment configuration — the production api/.env lives
# only on the server and is protected from deployment.
.env
.env.local
!.env.example

node_modules/
dist/
web/node_modules/
web/dist/

server-php/vendor/
server-php/writable/cache/*
server-php/writable/logs/*
server-php/writable/session/*
server-php/writable/uploads/*
server-php/writable/debugbar/*
!server-php/writable/**/.gitkeep
!server-php/writable/**/index.html
server-php/REVISION

*.log
.DS_Store
.idea/
.vscode/
